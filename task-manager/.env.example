# Copy this file to ".env" and adjust the values. NEVER commit the real .env file.
# docker-compose.yml reads these automatically when they are set in .env.

# ---------- Database (used by the docker-compose mysql service) ----------
MYSQL_DATABASE=taskmanager
MYSQL_ROOT_PASSWORD=root
# Host port for the containerized MySQL (3306 is the default MySQL port)
MYSQL_HOST_PORT=3306

# ---------- Database (used when running the backend WITHOUT Docker) ----------
# Point this at YOUR local MySQL that is already installed.
DB_URL=jdbc:mysql://localhost:3306/taskmanager?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# ---------- JWT ----------
# Must be at least 32 characters long. Use a long random string in production.
JWT_SECRET=change-me-in-production-this-is-a-very-long-default-secret-key-1234567890
JWT_EXPIRATION_MS=86400000

# ---------- Mail ----------
# For local testing MailHog is used (see docker-compose.yml).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@taskmanager.local

# For real Gmail sending, uncomment and fill these in instead:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# ---------- Default admin account (created on first start) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@taskmanager.local
ADMIN_PASSWORD=admin123

# ---------- Reminder job ----------
# Spring cron (6 fields). Default: every hour on the hour.
REMINDER_CRON=0 0 * * * *
